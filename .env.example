# 택배메이트 로컬 개발용 환경변수 예시
# 이 파일을 .env로 복사한 뒤 실제 프로젝트 값으로 채우세요.
# REACT_APP_* 값은 CRA 빌드 결과물에 포함될 수 있으므로 서버 전용 비밀키를 넣지 마세요.

# Firebase Web App client configuration
REACT_APP_API_KEY=YOUR_FIREBASE_WEB_API_KEY
REACT_APP_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
REACT_APP_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
REACT_APP_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
REACT_APP_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
REACT_APP_APP_ID=YOUR_FIREBASE_APP_ID
REACT_APP_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# Supabase client configuration
# anon/publishable key만 사용하세요. service_role 키는 절대 넣지 마세요.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# 기상청 단기예보 API 서비스 키
# CRA 앱에 포함되어 사용자에게 노출될 수 있습니다. 사용량 제한을 설정하세요.
REACT_APP_KMA_API_KEY=YOUR_KMA_DATA_GO_KR_SERVICE_KEY

# Google Drive 연동을 사용하는 경우에만 필요(선택 사항)
# REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
# REACT_APP_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
